# OnePlus 9 Pro Android 17 BPF manifest
MANIFEST_REPO=https://github.com/tqmane/android_kernel_manifest.git
MANIFEST_BRANCH=ci/a17-bpf-runtime-hardening

# Both profiles build the same current, boot-tested kernel branch. The profile
# changes only BUILD_CONFIG; temporary fix branches may be supplied explicitly
# through the workflow's optional kernel_ref input while a kernel PR is tested.
KERNEL_REF=oneplus/sm8350v_17.0.0_oneplus9pro_sukisu

# Android kernel build framework profiles
PLAIN_BUILD_CONFIG=kernel/msm-5.4/build.config.lemonade
CONTAINER_BUILD_CONFIG=kernel/msm-5.4/build.config.lemonade.container
VARIANT=qgki
LTO=thin
BUILD_KERNEL=1
KERNEL_IMAGE_NAME=Image

# Optional build acceleration
ENABLE_CCACHE=true
