# OnePlus 9 Pro Android 17 BPF manifest source
MANIFEST_REPO=https://github.com/tqmane/android_kernel_manifest.git
MANIFEST_BRANCH=oneplus/sm8350v_15.0.0_oneplus9pro

# Kernel ref used when workflow input kernel_ref is empty.
DEFAULT_KERNEL_REF=oneplus/sm8350v_17.0.0_oneplus9pro_sukisu

# Android kernel build framework
BUILD_CONFIG=kernel/msm-5.4/build.config.lemonade
VARIANT=qgki
LTO=thin
BUILD_KERNEL=1
KERNEL_IMAGE_NAME=Image

# QGKI fragment optionally extended by the containers profile. The plain
# profile leaves this file byte-for-byte unchanged after repo sync.
CONFIG_FRAGMENT=kernel/msm-5.4/arch/arm64/configs/vendor/lahaina_QGKI.config

# Build acceleration only; this does not alter the resulting kernel config.
ENABLE_CCACHE=true
