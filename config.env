# OnePlus 9 Pro manifest source
MANIFEST_REPO=https://github.com/tqmane/android_kernel_manifest.git
MANIFEST_BRANCH=oneplus/sm8350v_15.0.0_oneplus9pro

# Android kernel build framework
# The manifest README currently names build.config.msm.lemonade, but the actual
# OnePlus 9/9 Pro build config in the kernel tree is build.config.lemonade.
BUILD_CONFIG=kernel/msm-5.4/build.config.lemonade
VARIANT=qgki
LTO=thin
BUILD_KERNEL=1
KERNEL_IMAGE_NAME=Image

# QGKI fragment modified before build/build.sh generates the final defconfig
CONFIG_FRAGMENT=kernel/msm-5.4/arch/arm64/configs/vendor/lahaina_QGKI.config

# Keep LXC + Docker support enabled
LXC_DOCKER=true
LXC_PATCH=true
ANDROID_PARANOID_NETWORK_OFF=true

# Optional extras
ENABLE_KVM=false
ENABLE_CCACHE=true
