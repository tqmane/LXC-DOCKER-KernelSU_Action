# OnePlus 9 Pro Android 17 BPF manifest
MANIFEST_REPO=https://github.com/tqmane/android_kernel_manifest.git
MANIFEST_BRANCH=ci/a17-bpf-runtime-hardening

# Selectable kernel sources. The plain profile contains only the Android 17 BPF
# runtime hardening. The container profile is a dedicated branch derived from
# the same canonical hardening commit and adds Docker, LXC and KVM configuration.
PLAIN_KERNEL_REF=fix/a17-bpf-task-storage-hardening
PLAIN_KERNEL_EXPECTED_SHA=a2e1157f04e2fdea8c00de7ad6d7a3cb63ee0db1
CONTAINER_KERNEL_REF=oneplus/sm8350v_17.0.0_oneplus9pro_sukisu_lxc_docker_kvm_v2
CONTAINER_KERNEL_EXPECTED_SHA=9c3970bda39bc8f1b2c0684d8217e2bef2456195

# Android kernel build framework profiles
PLAIN_BUILD_CONFIG=kernel/msm-5.4/build.config.lemonade
CONTAINER_BUILD_CONFIG=kernel/msm-5.4/build.config.lemonade.container
VARIANT=qgki
LTO=thin
BUILD_KERNEL=1
KERNEL_IMAGE_NAME=Image

# Optional build acceleration
ENABLE_CCACHE=true
